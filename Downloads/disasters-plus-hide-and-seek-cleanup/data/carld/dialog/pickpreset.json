{
  "type": "minecraft:multi_action",
  "title": {
    "text": "Pick a Preset!",
    "bold": false,
    "italic": false
  },
  "inputs": [],
  "can_close_with_escape": true,
  "pause": false,
  "after_action": "none",
  "exit_action": {
    "label": "Return to Menu",
