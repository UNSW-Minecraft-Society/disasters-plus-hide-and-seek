      "tooltip": "The original 15 disasters in adventure mode!",
      "width": 120,
      "action": {
        "type": "minecraft:run_command",
        "command": "function carld:disasters/settings/basic"
      }
    },
    {
      "label": "Disaster Remaster",
      "tooltip": "A remastered mode, with better gameplay and cooler disasters.",
      "width": 120,
      "action": {
        "type": "minecraft:run_command",
        "command": "function carld:disasters/settings/remasters"
      }
    },
    {
      "label": "Survival Disasters",
      "tooltip": "A remixed mode, with slightly different disasters for survival mode.",
      "width": 120,
      "action": {
        "type": "minecraft:run_command",
        "command": "function carld:disasters/settings/survival"
      }
    },
    {
      "label": "Chaos Disasters",
      "tooltip": "No rules, all disasters! Chaotic, fast, unfair, fun.",
      "width": 120,
      "action": {
        "type": "minecraft:run_command",
        "command": "function carld:disasters/settings/chaos"
    }
   }
  ]
}