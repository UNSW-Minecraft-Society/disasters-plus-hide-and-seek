      "width": 120,
      "action": {
        "type": "minecraft:run_command",
        "command": "function carld:disasters/settings/mode/remasters"
      }
    },
    {
      "label": "Survival Disasters Pool",
      "tooltip": "A remixed set of disasters",
      "width": 120,
      "action": {
        "type": "minecraft:run_command",
        "command": "function carld:disasters/settings/mode/survival"
      }
    },
    {
      "label": "Chaos Disasters Pool",
      "tooltip": "Every disaster that's functional.",
      "width": 120,
      "action": {
        "type": "minecraft:run_command",
        "command": "function carld:disasters/settings/mode/chaos"
