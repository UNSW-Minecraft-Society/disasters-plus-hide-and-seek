{
  "type": "minecraft:multi_action",
  "title": {
    "text": "Pick what happens after players die.",
    "bold": false,
    "italic": false
  },
  "inputs": [],
  "can_close_with_escape": true,
  "pause": false,
  "after_action": "none",
  "exit_action": {
    "label": "Return to Menu",
    "action": {
      "type": "minecraft:run_command",
      "command": "dialog show @s carld:disasterpicker"
    }
  },
  "columns": 1,
  "actions": [
    {
      "label": "Spectators",
      "tooltip": "Players spectate the game once dead.",
      "width": 120,
      "action": {
        "type": "minecraft:run_command",
        "command": "scoreboard players set DeathMode settings 1"
      }
    },
    {
      "label": "Zombies",
      "tooltip": "The dead are resurrected to fight the living as zombies.",
      "width": 120,
      "action": {
        "type": "minecraft:run_command",
        "command": "scoreboard players set DeathMode settings 2"
      }
    }
  ]
}