{
  "type": "minecraft:multi_action",
  "title": {
    "text": "Pick the speed at which new disasters appear.",
    "bold": false,
    "italic": false
  },
  "inputs": [],
  "can_close_with_escape": true,
  "pause": false,
  "after_action": "none",
  "exit_action": {
    "label": "Return to Menu",
    "action": {
      "type": "minecraft:run_command",
      "command": "dialog show @s carld:disasterpicker"
    }
  },
  "columns": 1,
  "actions": [
    {
      "label": "60 Seconds",
      "tooltip": "New disasters take 60 seconds to appear.",
      "width": 120,
      "action": {
        "type": "minecraft:run_command",
        "command": "scoreboard players set Speed settings 1"
      }
    },
    {
      "label": "30 Seconds",
      "tooltip": "New disasters take 30 seconds to appear.",
      "width": 120,
      "action": {
        "type": "minecraft:run_command",
        "command": "scoreboard players set Speed settings 2"
      }
    },
    {
      "label": "15 Seconds",
      "tooltip": "New disasters take 15 seconds to appear.",
      "width": 120,
      "action": {
        "type": "minecraft:run_command",
        "command": "scoreboard players set Speed settings 3"
      }
    }
  ]
}