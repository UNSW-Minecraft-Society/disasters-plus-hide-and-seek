{
  "type": "minecraft:multi_action",
  "title": {
    "text": "Pick a Starting Kit!",
    "bold": false,
    "italic": false
  },
  "inputs": [],
  "can_close_with_escape": true,
  "pause": false,
  "after_action": "none",
  "exit_action": {
    "label": "Return to Menu",
    "action": {
      "type": "minecraft:run_command",
      "command": "dialog show @s carld:disasterpicker"
    }
  },
  "columns": 1,
  "actions": [
    {
      "label": "No Kit",
      "tooltip": "Players start with nothing on them.",
      "width": 120,
      "action": {
        "type": "minecraft:run_command",
        "command": "scoreboard players set Kit settings 0"
      }
    },
    {
      "label": "Basic Kit",
      "tooltip": "Players starting with basic wooden tools and food.",
      "width": 120,
      "action": {
        "type": "minecraft:run_command",
        "command": "scoreboard players set Kit settings 1"
      }
    }
  ]
}